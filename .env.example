# Copy to .env and fill in. Never commit real secrets.

# Live key recommended (transcribe:jobs + recap:read). Sandbox keys (pyai_test_)
# only cover hear:transcribe and cannot power CallProof diarized QA / Recap.
# If left blank, the API may mint a short-lived sandbox key at startup.
PYAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: PyAI Recap pack (e.g. sales_outbound). Uses org default if empty.
# Requires Recap add-on enabled + recap:read (and recap:configure to turn on).
RECAP_PACK_ID=
