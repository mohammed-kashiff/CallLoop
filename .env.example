# Copy to .env and fill in. Never commit real secrets.

# Live key recommended (transcribe:jobs + recap:read). Sandbox keys (pyai_test_)
# only cover hear:transcribe and cannot power CallProof diarized QA / Recap.
# If left blank, the API may mint a short-lived sandbox key at startup.
PYAI_API_KEY=

ANTHROPIC_API_KEY=

# Optional: PyAI Recap pack (e.g. sales_outbound). Uses org default if empty.
# Requires Recap add-on enabled + recap:read (and recap:configure to turn on).
RECAP_PACK_ID=

# Optional default To: for Gmail compose ("Send email to stakeholder").
# The button opens Gmail in the browser; the user sends from their own account.
STAKEHOLDER_EMAIL=

# Optional SMTP (not used by the Gmail compose button).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# STARTTLS on 587 (default). For port 465 set SMTP_USE_SSL=true and SMTP_USE_TLS=false.
SMTP_USE_TLS=true
SMTP_USE_SSL=false
